{
  "name": "@audiflo/phonematix",
  "version": "0.1.0",
  "type": "module",
  "description": "Format-agnostic phoneme conversion between various different formats",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --no-config --format esm,cjs --dts --sourcemap --minify --clean --out-dir dist",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "make-pretty": "prettier --write .",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}