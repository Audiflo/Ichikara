{
  "name": "@audiflo/ichikara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Build",
    "Demo"
  ],
  "scripts": {
    "postinstall": "node Build/scripts/repair-declarations.mjs",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w Build && npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "check": "npm run typecheck && npm run lint && npm test && npm run build -w Demo",
    "make-pretty": "npm run make-pretty --workspaces",
    "build:voicebank": "npm run build:voicebank -w Build"
  },
  "license": "MIT"
}
