{
  "name": "ichikara",
  "version": "0.1.0",
  "type": "module",
  "description": "Parametric vocal synthesis engine",
  "license": "MIT",
  "author": "NellowTCS (https://github.com/NellowTCS)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NellowTCS/Ichikara.git"
  },
  "homepage": "https://github.com/NellowTCS/Ichikara#readme",
  "bugs": {
    "url": "https://github.com/NellowTCS/Ichikara/issues"
  },
  "keywords": [
    "ichikara",
    "synthesis",
    "singing",
    "voice",
    "speech",
    "audio",
    "dsp",
    "lf-glottal",
    "source-filter",
    "formant"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "npm run build:g2p && tsdown src/index.ts --no-config --format esm,cjs --dts --sourcemap --minify --clean --out-dir dist",
    "build:g2p": "npm run build:g2p:en && npm run build:g2p:jp",
    "build:g2p:en": "tsx scripts/build-g2p-en.ts",
    "build:g2p:jp": "tsx scripts/build-g2p-jp.ts",
    "build:voicebank": "tsx scripts/build-voicebank.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "make-pretty": "prettier --write .",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@nisoku/satori": "^0.1.3",
    "@sevenc-nanashi/utaformatix-ts": "npm:@jsr/sevenc-nanashi__utaformatix-ts@^0.4.1"
  }
}
